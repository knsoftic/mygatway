APP_NAME="Gatevault"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
# Re-confirm password before sensitive admin pages after 15 minutes
AUTH_PASSWORD_TIMEOUT=900

LOG_CHANNEL=stack
# Use "json" in production for structured logs (see config/logging.php)
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crypto_gateway
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use "redis" in production; "database" works for single-server setups
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Gateway platform settings
# ---------------------------------------------------------------------------
# Comma-separated list of trusted reverse proxies (e.g. 127.0.0.1 for Nginx on the same host)
TRUSTED_PROXIES=127.0.0.1
# Secret pepper used to hash merchant API secrets (generate: php artisan gateway:generate-pepper)
GATEWAY_API_KEY_PEPPER=
# Require an administrator to approve every payout before it is sent to a provider
GATEWAY_PAYOUT_MANUAL_APPROVAL=true
# Block merchant webhook URLs that resolve to private/internal IP ranges (keep true in production)
GATEWAY_WEBHOOK_BLOCK_PRIVATE_IPS=true

# ---------------------------------------------------------------------------
# Cryptomus (https://doc.cryptomus.com) - LIVE credentials, server-side only
# ---------------------------------------------------------------------------
CRYPTOMUS_BASE_URL=https://api.cryptomus.com
CRYPTOMUS_MERCHANT_ID=
# Payment API key (merchant Settings tab) - signs payment requests and payment webhooks
CRYPTOMUS_PAYMENT_KEY=
# Payout API key (Business settings) - signs payout requests
CRYPTOMUS_PAYOUT_KEY=
# Cryptomus sends webhooks only from this IP (per official docs)
CRYPTOMUS_WEBHOOK_IPS=91.227.144.54
CRYPTOMUS_ENFORCE_WEBHOOK_IP=true

# ---------------------------------------------------------------------------
# Binance Pay Merchant API (https://developers.binance.com/en/docs/products/binance-pay-merchant)
# ---------------------------------------------------------------------------
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
# API identity key (sent as BinancePay-Certificate-SN)
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
# Wallet used to fund payouts: FUNDING_WALLET, SPOT_WALLET or FUNDING_AND_SPOT_WALLET
BINANCE_PAY_PAYOUT_WALLET=FUNDING_WALLET
